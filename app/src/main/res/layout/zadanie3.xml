<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ikona"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentLeft="true"
        android:contentDescription="ikona zadania"
        android:src="@android:drawable/ic_menu_agenda" />

    <ImageView
        android:id="@+id/stan"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentRight="true"
        android:contentDescription="stan"
        android:src="@android:drawable/checkbox_on_background" />

    <TextView
        android:id="@+id/tytul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/stan"
        android:layout_toRightOf="@id/ikona"
        android:paddingLeft="12dp"
        android:text="Zrobić zakupy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tytul"
        android:layout_toLeftOf="@id/stan"
        android:layout_toRightOf="@id/ikona"
        android:paddingLeft="12dp"
        android:text="Chleb, mleko, jajka" />

</RelativeLayout>
